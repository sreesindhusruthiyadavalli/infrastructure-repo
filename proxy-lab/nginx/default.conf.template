server {
    listen 8081;
    server_name demo.internal.test;

    return 301 https://$host:8443$request_uri;
}

server {
    listen 8443 ssl;
    server_name demo.internal.test;

    resolver __CONTAINER_DNS_RESOLVER__ ipv6=off valid=10s;
    set $demo_service_upstream http://demo-service:8080;

    ssl_certificate /etc/nginx/certs/demo.internal.test.crt;
    ssl_certificate_key /etc/nginx/certs/demo.internal.test.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 10m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location / {
        proxy_pass $demo_service_upstream;
    }
}